<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. "production" is what App Store / TestFlight builds use
	     (TestFlight talks to the production APNs environment). The matching
	     capability must also be enabled on the App ID (com.ccelim.app) in the
	     Apple Developer portal. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
