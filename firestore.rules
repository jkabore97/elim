rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function canPublish() {
      return isSignedIn() && (role() == 'church' || role() == 'admin' || role() == 'pastor');
    }

    // Who may use the transcription tool AND see the shared Scripts library:
    // admins/pastors, plus church leads with the 'transcribe' group capability
    // (legacy leads with no group stamp are grandfathered, like publishing).
    function canTranscribe() {
      return isSignedIn() && (
        isAdmin() ||
        (canPublish() && (!managedByGroups() || groupCap('transcribe')))
      );
    }

    // 'pastor' carries full admin rights - approvals, logs, everything -
    // so every existing isAdmin() check covers both accounts.
    function isAdmin() {
      return isSignedIn() && (role() == 'admin' || role() == 'pastor');
    }

    // Group-derived capability. A Cloud Function (syncGroupCaps) stamps each
    // lead's effective permissions onto their user doc as `groupCaps` whenever
    // a group changes; this reads that stamp so publishing surfaces can be
    // gated by group membership at the database level, not just in the UI.
    // Admins/pastors bypass this (they always have every capability).
    function groupCap(cap) {
      return isSignedIn()
             && 'groupCaps' in userDoc().data
             && userDoc().data.groupCaps is map
             && cap in userDoc().data.groupCaps
             && userDoc().data.groupCaps[cap] == true;
    }

    // Whether this account has ever been placed in the group system. Accounts
    // that never have (legacy publishers not yet assigned to any group) are
    // grandfathered so enabling enforcement can't lock out existing publishers;
    // the moment an admin assigns an account to groups, its stamped groupCaps
    // are enforced. Admins/pastors bypass all of this.
    function managedByGroups() {
      return isSignedIn() && 'groupCaps' in userDoc().data;
    }

    // Which capability a post being created requires: a health post needs
    // 'sante', anything else needs 'post'. Guards a missing section field.
    function postCapNeeded() {
      return ('section' in request.resource.data
              && request.resource.data.section == 'sante') ? 'sante' : 'post';
    }

    function conv(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId));
    }


    // ---- Users ----
    match /users/{userId} {
      // A user may read their OWN doc; staff (admin/pastor) and church leads
      // read others because the New-message picker and the Data explorer need
      // the directory. Plain members can no longer pull the whole users
      // collection (names, phones, emails, DOB, fcmTokens) - the feed and
      // messaging already carry denormalised author names/avatars, so members
      // never need another person's user doc. (Verified: the picker and Data
      // explorer are shown only to staff/church; members use ChannelChooser,
      // which reads only their own conversations.)
      allow read: if isSignedIn() && (
                    request.auth.uid == userId
                    || isAdmin()
                    || role() == 'church'
                  );
      allow create: if isSignedIn() && request.auth.uid == userId
                    // Users can only self-assign 'member' or 'pending_church' on signup —
                    // never 'church' or 'admin' directly.
                    && request.resource.data.role in ['member', 'pending_church']
                    // groupCaps is set ONLY by the syncGroupCaps function (Admin SDK):
                    // a user must never seed their own capabilities at signup.
                    && !('groupCaps' in request.resource.data);
      allow update: if isSignedIn() && (
                      // users can update their own profile, but never their own role
                      // or their group capabilities (groupCaps is function-owned; a
                      // self-write of it would bypass the group-permission enforcement).
                      (request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('groupCaps', {}) == resource.data.get('groupCaps', {}))
                      ||
                      // an admin may approve/deny a pending church — but ONLY that:
                      // the target must currently be pending_church, the new role must
                      // be church (approve) or member (deny), and nothing else on the
                      // document may change in the same write.
                      (isAdmin() && userId != request.auth.uid
                        && resource.data.role == 'pending_church'
                        && request.resource.data.role in ['church', 'member']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
                      ||
                      // Admin/pastor editing via the Data explorer. Leads are
                      // deliberately excluded - they get read-only access.
                      // Role is frozen on this path: promoting or demoting an
                      // account must go through the pending_church approval
                      // clause above or a direct console action - never
                      // free-text field editing (SECURITY.md §3). groupCaps is
                      // also frozen here - it is owned by syncGroupCaps, and
                      // group permissions are managed via the Groups panel.
                      (isAdmin()
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('groupCaps', {}) == resource.data.get('groupCaps', {}))
                    );
      allow delete: if isAdmin();

      // Private profile fields (e.g. date of birth) kept OUT of the
      // church-readable user doc. Only the owner and admins may read or write
      // them, so a lead reading the users directory can't see them. The
      // stripDobToPrivate function (Admin SDK) also writes here.
      match /private/{docId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ---- Messaging ----
    // Two support channels, each answered by one account:
    //   'pastor' threads -> the pastor account
    //   'tech'   threads -> the technical admin account
    // They're separated deliberately: a pastoral message is often personal,
    // and shouldn't land in a technical support queue.
    function isPastor() { return isSignedIn() && role() == 'pastor'; }
    function isTechAdmin() { return isSignedIn() && role() == 'admin'; }

    // Can this user answer the given channel type?
    function ownsChannel(convType) {
      return (convType == 'pastor' && isPastor())
             || (convType == 'tech' && isTechAdmin());
    }

    match /conversations/{convId} {
      allow read: if isSignedIn() && (
                    request.auth.uid in resource.data.participantIds
                    || ownsChannel(resource.data.type)
                  );

      // Anyone signed in may open their OWN pastor/tech thread - and only
      // their own: participantIds must be exactly [their uid]. A 'direct'
      // thread can only be created by the pastor or the technical admin,
      // and only one they're actually part of. So a member cannot open a
      // thread with another member even by crafting the request by hand.
      allow create: if isSignedIn() && (
                      (request.resource.data.type in ['pastor', 'tech']
                        && request.resource.data.participantIds == [request.auth.uid])
                      || (request.resource.data.type == 'direct'
                        && (isPastor() || isTechAdmin())
                        && request.auth.uid in request.resource.data.participantIds)
                    );

      // A participant/owner may only touch the runtime fields (last message,
      // read state, typing). type and participantIds are FROZEN after creation:
      // without this a participant could flip a thread to type 'church' and add
      // other members to participantIds, turning it into a church-branded
      // push/inbox broadcast to the whole congregation.
      allow update: if isSignedIn()
                    && (request.auth.uid in resource.data.participantIds
                        || ownsChannel(resource.data.type))
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.participantIds == resource.data.participantIds;

      // Either side may delete the whole thread. Note this deletes it for
      // EVERYONE, not just the person doing it - there is no per-user hiding.
      allow delete: if isSignedIn() && (
                      request.auth.uid in resource.data.participantIds
                      || ownsChannel(resource.data.type)
                    );
    }

    match /messages/{msgId} {
      // participantIds is denormalized onto each message so this check needs
      // no get() on the parent conversation - that would otherwise be one
      // extra document read per message, on every message, forever.
      allow read: if isSignedIn() && (
                    request.auth.uid in resource.data.participantIds
                    || isPastor() || isTechAdmin()
                  );

      // The message's participantIds must EQUAL the parent conversation's.
      // Without this, a member could inject a message into a private thread
      // they aren't in by hand-listing themselves in the denormalised array
      // (the array is what read/create are checked against). The client always
      // upserts the conversation - with these same participantIds - before the
      // message, so the parent exists and matches; the one extra read is the
      // correct price for closing the injection.
      // senderRole MUST equal the sender's real role, so a member cannot post a
      // message that renders with a Pastor/Admin badge (the UI badges purely off
      // senderRole). The 'church' channel is server-only: clients may never
      // write into a type=='church' thread - only the Admin SDK does, which
      // bypasses these rules. Both together stop church/staff impersonation.
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.senderRole == role()
                    && conv(request.resource.data.conversationId).data.type != 'church'
                    && request.resource.data.participantIds ==
                         conv(request.resource.data.conversationId).data.participantIds
                    && (
                      request.auth.uid in request.resource.data.participantIds
                      || isPastor() || isTechAdmin()
                    );

      // Editing is restricted to the SENDER, and to the text only: rewriting
      // someone else's words would leave them attributed to a person who
      // never wrote them. senderId, participantIds and conversationId can
      // never be altered, so a message can't be re-pointed at another thread
      // or another author.
      allow update: if isSignedIn()
                    && resource.data.senderId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['text', 'editedAt']);

      // Deleting is available to the sender, and to staff for moderation.
      allow delete: if isSignedIn() && (
                      resource.data.senderId == request.auth.uid
                      || isPastor() || isTechAdmin()
                    );
    }

    // ---- Library (PDF books) ----
    match /books/{bookId} {
      allow read: if isSignedIn();
      // Uploading a library book needs the 'books' group permission (admins and
      // pastors always pass).
      allow create: if canPublish()
                    && request.resource.data.uploadedById == request.auth.uid
                    && (isAdmin() || !managedByGroups() || groupCap('books'));
      // The uploader/admin may edit the book; any signed-in reader may bump the
      // 'views' counter by one when they open it (same bounded-nudge pattern as
      // post likes, so it can't be set to an arbitrary value).
      allow update: if isSignedIn() && (
                      resource.data.uploadedById == request.auth.uid || isAdmin() ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                        && request.resource.data.views is int
                        && request.resource.data.views >= 0
                        && (!('views' in resource.data)
                            || (request.resource.data.views >= resource.data.views
                                && request.resource.data.views <= resource.data.views + 1)))
                    );
      allow delete: if isSignedIn() && (resource.data.uploadedById == request.auth.uid || isAdmin());
    }

    // ---- Activity logs ----
    // Admin-only visibility. Any signed-in user can append entries about
    // their own actions (that's how sign-ins/posts get recorded at all),
    // but the userId must match their own uid, so nobody can fabricate
    // entries attributed to someone else. Immutable once written - no
    // updates or deletes, by anyone, including admins.
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      // The creator must be the acting user, the recorded role must match
      // their REAL role (so a member can't forge an entry that reads as an
      // admin action), the timestamp must be server-stamped, and the detail
      // string is bounded. Matches what the client already writes.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userRole == role()
                    && request.resource.data.createdAt == request.time
                    && (!('detail' in request.resource.data)
                        || (request.resource.data.detail is string
                            && request.resource.data.detail.size() <= 200));
      // Never editable, by anyone - the log is only useful if it can't be
      // quietly rewritten. Admins may delete for retention housekeeping.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Church directory ----
    // A minimal public mirror of church accounts (name only), specifically so
    // the member-signup form can populate a "pick your church" dropdown
    // *before* the person has an authenticated session at all. Written only
    // by the admin-approval flow in the client - never directly reachable
    // by anyone else. Deliberately excludes email/phone/anything sensitive.
    match /churchDirectory/{churchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shareable projection of each user (name, photo, profession, interests,
    // role) — the safe fields shown in the tap-to-view profile popup. Members
    // can't read the users collection, so this world-readable mirror powers the
    // popup via a direct Firestore read. Written ONLY by the syncPublicProfile /
    // backfillPublicProfiles functions (Admin SDK); no client writes.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Publishing groups ----
    // Ministries / departments a post can be attributed to. Readable by any
    // signed-in user (a lead's composer lists the groups they may publish
    // under; membership is the `leads` map). Only admins/pastors create, edit,
    // assign leads, or delete — leads never edit the group itself.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Transcription jobs (Read-tab upload tool) ----
    // A lead creates a job doc (status 'processing') for a file they just
    // uploaded, then subscribes to it; the transcribeUpload Cloud Function
    // fills in the text (Admin SDK). The lead may read and delete their own
    // job, but never edit it - the result must come from the function.
    match /transcribeJobs/{jobId} {
      // The Scripts library is SHARED: anyone with transcription access (leads
      // with the cap, admins/pastors) can read every job. The owner can always
      // read their own.
      allow read: if canTranscribe() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if canPublish()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'processing'
                    && (isAdmin() || !managedByGroups() || groupCap('transcribe'));
      allow update: if false;
      // Delete: the owner, or an admin/pastor tidying the shared library.
      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // ---- Posts ----
    match /posts/{postId} {
      allow read: if isSignedIn();
      // Publishing requires the church/admin role. Email verification is
      // encouraged (see the in-app banner) but does not block publishing —
      // see SECURITY.md §3 for the reasoning.
      // One rule for both surfaces: publishing needs the lead/admin/pastor
      // role. Doctors are given a lead account rather than being granted
      // rights by profession, so there is a single permission to reason about
      // and revoking access is one role change.
      // Publishing needs the church/admin/pastor role AND, for a plain lead,
      // the group permission for that surface: a health post ('sante' section)
      // needs the 'sante' capability, any other post needs 'post'. Admins and
      // pastors always pass. This enforces the group permissions at the
      // database level, not only by hiding buttons in the app.
      allow create: if canPublish()
                    && request.resource.data.churchId == request.auth.uid
                    && (isAdmin()
                        || !managedByGroups()
                        || groupCap(postCapNeeded()));
      // The owning church/admin can edit or delete their own post (and only
      // their own — see SECURITY.md §4); any signed-in member can separately
      // bump likes or the comment counter.
      // The owner/admin may edit their post; anyone signed in may nudge ONE
      // counter by one in either direction. The client only ever changes a
      // single counter per write (a like touches 'likes', a comment touches
      // 'commentsCount'), so bounding each on its own closes the "set likes to
      // 999999" vandalism without blocking either action. The '!in resource'
      // arm lets the first like/comment land on a post created before the
      // field existed.
      allow update: if isSignedIn() && (
                      (resource.data.churchId == request.auth.uid) ||
                      isAdmin() ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        && request.resource.data.likes is int
                        && request.resource.data.likes >= 0
                        && (!('likes' in resource.data)
                            || (request.resource.data.likes >= resource.data.likes - 1
                                && request.resource.data.likes <= resource.data.likes + 1))) ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
                        && request.resource.data.commentsCount is int
                        && request.resource.data.commentsCount >= 0
                        && (!('commentsCount' in resource.data)
                            || (request.resource.data.commentsCount >= resource.data.commentsCount - 1
                                && request.resource.data.commentsCount <= resource.data.commentsCount + 1)))
                    );
      allow delete: if isSignedIn() && (resource.data.churchId == request.auth.uid || isAdmin());
    }

    // ---- Comments ----
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
                      isAdmin() ||
                      // Any signed-in member may nudge the like counter by one
                      // in either direction. The authoritative per-user state
                      // lives in commentLikes; this is only the shown count.
                      // The first like on a pre-existing comment (no 'likes'
                      // field yet) just has to land a non-negative integer.
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        && request.resource.data.likes is int
                        && request.resource.data.likes >= 0
                        && (!('likes' in resource.data)
                            || (request.resource.data.likes >= resource.data.likes - 1
                                && request.resource.data.likes <= resource.data.likes + 1)))
                    );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---- Likes ----
    // One doc per postId+userId (doc ID is literally "{postId}_{userId}"),
    // which is what makes "has this user already liked this post" a simple
    // existence check instead of needing a query, and prevents a user from
    // creating more than one like doc for the same post under a different ID.
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && likeId == (request.resource.data.postId + '_' + request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ---- Post views / shares ----
    // One doc per postId+userId (ID "{postId}_{userId}"), exactly like likes:
    // the per-user doc is the source of truth and a Cloud Function recomputes
    // posts.views / posts.shares from the real number of these docs. A person
    // can only ever write their own single doc per post, so the counts can't be
    // inflated. Immutable once written; the count lives on the post, not here.
    match /postViews/{viewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && viewId == (request.resource.data.postId + '_' + request.auth.uid);
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /postShares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && shareId == (request.resource.data.postId + '_' + request.auth.uid);
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---- App config (donation details, etc.) ----
    // Readable by any signed-in user (everyone sees how to give); only
    // admins/pastors can edit.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Notifications ----
    // Created ONLY by Cloud Functions (the Admin SDK bypasses these rules), so
    // no client can forge a notification for someone else. A recipient may read
    // their own, mark them read, or delete them - nothing more.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // Broadcast announcements (quiz reminders, champions, app-update notices):
    // one shared doc per broadcast, readable by every signed-in member so the
    // in-app bell can show it. Written ONLY by the broadcastPush Cloud Function
    // (Admin SDK, which bypasses rules); clients can never create or change one.
    // Read state is tracked per-device on the client, not stored here.
    match /announcements/{announceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admin-scheduled broadcasts, waiting to be sent by dispatchScheduledBroadcasts.
    // Admins create and delete them; the dispatcher (Admin SDK) flips `sent` and
    // stamps `sentAt`, so clients never update one.
    match /scheduledBroadcasts/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.sent == false;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---- Donations (declarations) ----
    // A member declares a donation AFTER paying outside the app (mobile
    // money / PayPal / card link) - the app never touches the money itself.
    // The declaration triggers the thank-you message (Cloud Function) and
    // feeds the treasurer's ledger in the Admin tab.
    //
    // Reads: staff, or the donor reading their own declarations. Donation
    // records (a dime is a tithe) are sensitive - they must never be
    // readable across members.
    match /donations/{donationId} {
      allow read: if isSignedIn()
                  && (isAdmin() || resource.data.donorId == request.auth.uid);

      allow create: if isSignedIn()
                    && request.resource.data.donorId == request.auth.uid
                    && request.resource.data.status == 'declared'
                    && request.resource.data.type in ['dime', 'offrande', 'autre']
                    // Only the fields a self-declaration legitimately carries -
                    // so a member can't smuggle in provider/verifiedById/
                    // amountCents/squarePaymentId to dress a declaration up as a
                    // Square-verified gift for any exporter that trusts them.
                    && request.resource.data.keys().hasOnly(
                         ['donorId', 'donorName', 'type', 'purpose', 'amount',
                          'currency', 'methodId', 'methodLabel', 'status', 'createdAt'])
                    && (!('purpose' in request.resource.data)
                        || request.resource.data.purpose.size() <= 300)
                    && (!('amount' in request.resource.data)
                        || request.resource.data.amount.size() <= 30)
                    && (!('methodLabel' in request.resource.data)
                        || request.resource.data.methodLabel.size() <= 60);

      // Only staff may verify, and only by moving the status and stamping the
      // reviewer - the declaration itself stays exactly as the donor filed it.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'verifiedById', 'verifiedByName', 'verifiedAt'])
                    && request.resource.data.status in ['declared', 'verified'];

      allow delete: if false;
    }

    // ---- Safety reports ----
    // In-app reporting, required by Google Play's child safety standards
    // policy. Write-only for ordinary users: anyone signed in may file a
    // report about content, but only staff can READ the queue. That matters -
    // if reports were world-readable they would become a way to enumerate
    // other people's content and to see who reported whom.
    //
    // Reports are immutable to their author once filed (no update, no delete),
    // so a reporter cannot retract or rewrite a child-safety report after
    // staff have seen it; only staff may resolve one, and only by moving the
    // status and stamping who reviewed it.
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.targetType in ['post', 'comment', 'message', 'user']
                    && request.resource.data.reason in
                         ['child_safety', 'sexual', 'violence', 'harassment', 'spam', 'other']
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    // Bound the free-text fields so a report can't be used as
                    // cheap storage or to blow up the review screen.
                    && (!('details' in request.resource.data)
                        || request.resource.data.details.size() <= 1000)
                    && (!('preview' in request.resource.data)
                        || request.resource.data.preview.size() <= 300);

      // Staff resolve a report; they may only move it out of 'open' and record
      // who did it. The original report content stays exactly as filed.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedById', 'reviewedByName', 'reviewedAt'])
                    && request.resource.data.status in ['actioned', 'dismissed'];

      allow delete: if false;
    }

    // ---- Comment likes ----
    // Same shape as post likes: one doc per commentId+userId, doc ID
    // "{commentId}_{userId}", so "has this user liked this comment" is a plain
    // existence check and a user can't create two likes for one comment.
    match /commentLikes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && likeId == (request.resource.data.commentId + '_' + request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ---- Bible quiz player profiles ----
    // One doc per player (docId == uid): points, streaks, badges, weekly
    // score. Everyone signed in may READ the collection - that is what powers
    // the weekly leaderboard (names + weekPoints are meant to be seen by the
    // congregation). A player may only write their OWN document, and the
    // stored uid must match, so nobody can inflate someone else's score.
    // Scores are self-reported (the game runs on the client); this is a
    // friendly church game, not gambling, so that trade-off is acceptable and
    // matches how the donations/lightweight collections already work.
    match /quizProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && request.resource.data.uid == uid;
    }

    // ---- Bible quiz difficulty stats (one doc per question) ----
    // Aggregate attempt/correct counters written by the client (increments) and
    // turned into a measured difficulty by the weekly calibrateQuiz function.
    // Any signed-in player may bump the counters; the write is limited to those
    // three fields so nothing else can be smuggled in. Low-stakes: it only
    // affects difficulty calibration, never points or leaderboards. The
    // function's own writes (Admin SDK) bypass these rules.
    match /quizStats/{qid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.data.keys().hasOnly(['attempts', 'correct', 'updatedAt']);
    }

    // ---- Bible quiz weekly leaderboards (adults) ----
    // One doc per (week, league, player); league is a category id or 'grand'.
    // World-readable (the congregation sees the ranking); a player may only
    // write rows carrying their own uid. Points are self-reported, same
    // trade-off as quizProfiles above.
    match /quizWeekly/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ---- Bible quiz kids league ----
    // Keyed by parent account + child name. The parent (owner) writes their
    // children's rows; everyone may read them for the kids ranking and the
    // Sunday-school prize.
    match /quizKids/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Delete has no request.resource.data - authorise by the stored owner so a
      // parent can wipe their own child's score everywhere.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Bible quiz champions (Hall of Fame) ----
    // Written ONLY by Cloud Functions at week close (the Admin SDK bypasses
    // these rules), so no client can forge a championship. Everyone may read
    // the Palmarès.
    match /quizChampions/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
